{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "framer-motion": [
        "./node_modules/.pnpm/framer-motion@12.16.0_react-dom@19.1.1_react@19.1.1__react@19.1.1/node_modules/framer-motion"
      ],
      "framer-motion/*": [
        "./node_modules/.pnpm/framer-motion@12.16.0_react-dom@19.1.1_react@19.1.1__react@19.1.1/node_modules/framer-motion/*"
      ],
      "@supabase/auth-js": [
        "./node_modules/.pnpm/@supabase+supabase-js@2.119.0_@opentelemetry+api@1.9.0/node_modules/@supabase/auth-js"
      ],
      "@supabase/functions-js": [
        "./node_modules/.pnpm/@supabase+supabase-js@2.119.0_@opentelemetry+api@1.9.0/node_modules/@supabase/functions-js"
      ],
      "@supabase/postgrest-js": [
        "./node_modules/.pnpm/@supabase+supabase-js@2.119.0_@opentelemetry+api@1.9.0/node_modules/@supabase/postgrest-js"
      ],
      "@supabase/realtime-js": [
        "./node_modules/.pnpm/@supabase+supabase-js@2.119.0_@opentelemetry+api@1.9.0/node_modules/@supabase/realtime-js"
      ],
      "@supabase/storage-js": [
        "./node_modules/.pnpm/@supabase+supabase-js@2.119.0_@opentelemetry+api@1.9.0/node_modules/@supabase/storage-js"
      ],
      "@radix-ui/*": [
        "./node_modules/.pnpm/radix-ui@1.4.3_@types+react-dom@19.1.9_@types+react@19.1.12__@types+react@19.1.12_react-dom@1_kmqwzl43henqbjs7p7oa56k4we/node_modules/@radix-ui/*"
      ]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
