LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── Control plane ──────────────────────────────────────────────────────────────
# The worker holds no database credentials. It reads one Edge Function, guarded by
# AGENT_API_KEY, which returns the assistant's config bundle for a given id.
AGENT_CONFIG_URL=https://<project-ref>.supabase.co/functions/v1/assistant-config
AGENT_API_KEY=

# Must match AGENT_NAME in ui/.env.local and the dispatch in ui/app/api/token/route.ts
AGENT_NAME=my-agent

# ── Build-time snapshot ────────────────────────────────────────────────────────
# scripts/snapshot.py bakes a copy of the bundle into the image so a control-plane
# outage degrades to "config is stale" instead of "the agent cannot start".
# The id is the assistant whose config is snapshotted — for a single-user setup,
# your own assistant.
SNAPSHOT_ASSISTANT_ID=
# Where the snapshot is read from at runtime. Defaults to ./config_snapshot.json.
# CONFIG_SNAPSHOT_PATH=
